<Window x:Class="OpenCodeWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки OpenCode Go"
        Width="436"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="app.ico"
        KeyDown="Window_KeyDown">

    <Border Margin="16"
            CornerRadius="18"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            TextElement.Foreground="{StaticResource TextBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="0"
                              Opacity="0.58"
                              Color="#000000" />
        </Border.Effect>

        <Grid Margin="20,17,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="assets/logo.png"
                           Width="26"
                           Height="26"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Настройки"
                               Margin="8,0,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource IconButton}"
                        Click="Cancel_Click"
                        ToolTip="Закрыть">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10" />
                </Button>
            </Grid>

            <!-- API key -->
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <Grid>
                    <TextBlock Text="API-КЛЮЧ OPENCODE GO"
                               Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center" />
                    <Button x:Name="RevealButton"
                            HorizontalAlignment="Right"
                            Style="{StaticResource LinkButton}"
                            Content="Показать"
                            Click="Reveal_Click" />
                </Grid>

                <Grid Margin="0,7,0,0" Height="36">
                    <PasswordBox x:Name="KeyPassword"
                                 Style="{StaticResource KeyPasswordBox}"
                                 VerticalContentAlignment="Center" />
                    <TextBox x:Name="KeyText"
                             Style="{StaticResource KeyTextBox}"
                             Visibility="Collapsed"
                             VerticalContentAlignment="Center" />
                </Grid>

                <TextBlock Margin="0,7,0,0"
                           FontSize="10"
                           Foreground="{StaticResource FaintBrush}"
                           TextWrapping="Wrap"
                           LineHeight="15">
                    Console → Account → Personal API keys. Ключ шифруется средствами Windows
                    и хранится только на этом компьютере. Вход через Google не нужен:
                    виджету достаточно API-ключа.
                </TextBlock>

                <Grid Margin="0,9,0,0">
                    <Button x:Name="ImportButton"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="10.5"
                            Padding="10,5"
                            Content="Импортировать из OpenCode"
                            Click="Import_Click"
                            HorizontalAlignment="Left" />
                    <TextBlock x:Name="ImportStatus"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="2"
                    Height="1"
                    Background="{StaticResource DividerBrush}"
                    Margin="0,16,0,0" />

            <!-- Refresh interval -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="ОБНОВЛЕНИЕ"
                           Style="{StaticResource SectionLabel}" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="Refresh30"
                                 Grid.Column="0"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Refresh"
                                 Content="30 с"
                                 Tag="30"
                                 Margin="0,0,5,0" />
                    <RadioButton x:Name="Refresh60"
                                 Grid.Column="1"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Refresh"
                                 Content="1 мин"
                                 Tag="60"
                                 Margin="0,0,5,0" />
                    <RadioButton x:Name="Refresh300"
                                 Grid.Column="2"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Refresh"
                                 Content="5 мин"
                                 Tag="300"
                                 Margin="0,0,5,0" />
                    <RadioButton x:Name="Refresh900"
                                 Grid.Column="3"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Refresh"
                                 Content="15 мин"
                                 Tag="900" />
                </Grid>
            </StackPanel>

            <!-- Toggles -->
            <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <CheckBox x:Name="AlwaysOnTopToggle"
                          Style="{StaticResource Toggle}"
                          Content="Поверх всех окон" />
                <CheckBox x:Name="StartupToggle"
                          Style="{StaticResource Toggle}"
                          Content="Запускать вместе с Windows"
                          Margin="0,11,0,0" />
                <CheckBox x:Name="FullscreenToggle"
                          Style="{StaticResource Toggle}"
                          Content="Скрывать в полноэкранных приложениях"
                          Margin="0,11,0,0" />
                <TextBlock Text="Игра или фильм на весь экран: виджет спрячется и вернётся после."
                           FontSize="9"
                           Foreground="{StaticResource FaintBrush}"
                           Margin="46,5,0,0"
                           TextWrapping="Wrap" />

                <Border Height="1"
                        Background="{StaticResource DividerBrush}"
                        Margin="0,14,0,0" />
                <TextBlock Text="УВЕДОМЛЕНИЯ"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,12,0,0" />
                <CheckBox x:Name="NotifyToggle"
                          Style="{StaticResource Toggle}"
                          Content="Уведомления о лимитах"
                          Margin="0,9,0,0" />
                <Grid Margin="0,9,0,0">
                    <CheckBox x:Name="SoundToggle"
                              Style="{StaticResource Toggle}"
                              Content="Звук уведомлений" />
                    <Button x:Name="PreviewSoundButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource LinkButton}"
                            Content="Прослушать"
                            Click="PreviewSound_Click" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="SoundSoft"
                                 Grid.Column="0"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Sound"
                                 Content="Мягкий"
                                 Tag="soft"
                                 Margin="0,0,5,0" />
                    <RadioButton x:Name="SoundBell"
                                 Grid.Column="1"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Sound"
                                 Content="Звон"
                                 Tag="bell"
                                 Margin="0,0,5,0" />
                    <RadioButton x:Name="SoundWood"
                                 Grid.Column="2"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Sound"
                                 Content="Дерево"
                                 Tag="wood"
                                 Margin="0,0,5,0" />
                    <RadioButton x:Name="SoundDrop"
                                 Grid.Column="3"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Sound"
                                 Content="Капля"
                                 Tag="drop"
                                 Margin="0,0,5,0" />
                    <RadioButton x:Name="SoundMinimal"
                                 Grid.Column="4"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Sound"
                                 Content="Тон"
                                 Tag="minimal" />
                </Grid>
                <CheckBox x:Name="AnimateToggle"
                          Style="{StaticResource Toggle}"
                          Content="Подсветка рамки"
                          Margin="0,9,0,0" />
                <Grid Margin="46,5,0,0">
                    <TextBlock Text="Пороги: 70%, 90% и 100%."
                               FontSize="9"
                               Foreground="{StaticResource FaintBrush}"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource LinkButton}"
                            Content="Тест уведомления"
                            Click="TestNotification_Click" />
                </Grid>
            </StackPanel>

            <!-- Status -->
            <Border x:Name="StatusHost"
                    Grid.Row="5"
                    Visibility="Collapsed"
                    Margin="0,14,0,0"
                    CornerRadius="8"
                    Background="#12FFFFFF"
                    Padding="10,7">
                <TextBlock x:Name="StatusText"
                           FontSize="10.5"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="6" Margin="0,18,0,0">
                <Button x:Name="TestButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Проверить"
                        Click="Test_Click"
                        HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Отмена"
                            Margin="0,0,7,0"
                            Click="Cancel_Click" />
                    <Button x:Name="SaveButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Сохранить"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
