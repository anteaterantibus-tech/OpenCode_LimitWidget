<Window x:Class="OpenCodeWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCodeWidget.Controls"
        Title="OpenCode Go"
        Width="412"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="app.ico"
        KeyDown="Window_KeyDown">

    <Window.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Header="Обновить" Click="Refresh_Click" />
            <MenuItem Header="Настройки" Click="Settings_Click" />
            <Separator Style="{StaticResource MenuSeparator}" />
            <MenuItem Header="Обычный вид" Click="ModeNormal_Click" />
            <MenuItem Header="Компактный вид" Click="ModeCompact_Click" />
            <MenuItem Header="В панели задач" Click="ModeTaskbar_Click" />
            <Separator Style="{StaticResource MenuSeparator}" />
            <MenuItem Header="Скрыть в трей" Click="Hide_Click" />
            <Separator Style="{StaticResource MenuSeparator}" />
            <MenuItem Header="Выход" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <!-- Normal card -->
        <Border x:Name="NormalCard"
                Margin="16"
                CornerRadius="18"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                TextElement.Foreground="{StaticResource TextBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.58"
                                  Color="#000000" />
            </Border.Effect>

            <Grid Margin="18,15,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid x:Name="Header"
                      Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource LogoButton}"
                                Width="30"
                                Height="30"
                                ToolTip="Открыть статистику OpenCode"
                                AutomationProperties.Name="Открыть статистику OpenCode"
                                Click="ConsoleLink_Click">
                            <Image Source="assets/logo.png"
                                   Width="30"
                                   Height="30"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Button>
                        <TextBlock Text="OpenCode"
                                   Margin="8,0,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border x:Name="PlanBadgeHost"
                                Margin="7,0,0,0"
                                CornerRadius="5"
                                Background="{StaticResource AccentSoftBrush}"
                                Padding="5,2"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="PlanBadge"
                                       Text="Go"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CompactButton"
                                Style="{StaticResource IconButton}"
                                Click="CompactToggle_Click"
                                ToolTip="Компактный режим"
                                AutomationProperties.Name="Компактный режим">
                            <TextBlock Text="&#xE70D;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" />
                        </Button>
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource IconButton}"
                                Click="Refresh_Click"
                                ToolTip="Обновить"
                                AutomationProperties.Name="Обновить">
                            <TextBlock x:Name="RefreshGlyph"
                                       Text="&#xE72C;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       RenderTransformOrigin="0.5,0.5" />
                        </Button>
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource IconButton}"
                                Click="Settings_Click"
                                ToolTip="Настройки"
                                AutomationProperties.Name="Настройки">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource IconButton}"
                                Click="Hide_Click"
                                ToolTip="Скрыть в трей"
                                AutomationProperties.Name="Скрыть в трей">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Plan line -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveDot"
                                 Width="6"
                                 Height="6"
                                 Fill="{StaticResource WarningBrush}"
                                 Margin="0,0,6,0" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="Подключение..."
                                   FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   MaxWidth="250"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border x:Name="LoadChip"
                                Visibility="Collapsed"
                                CornerRadius="6"
                                Background="#2EFFB020"
                                BorderBrush="#66FFB020"
                                BorderThickness="1"
                                Padding="6,1"
                                Margin="0,0,7,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="StatusChip_Click"
                                ToolTip="Состояние OpenCode">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LoadChipDot"
                                         Width="5"
                                         Height="5"
                                         Fill="{StaticResource WarningBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,4,0" />
                                <TextBlock x:Name="LoadChipText"
                                           Text="Нагрузка"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="UpdatedText"
                                   Text=""
                                   VerticalAlignment="Center"
                                   FontSize="9.5"
                                   Foreground="{StaticResource FaintBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Error / empty state -->
                <Border x:Name="ErrorBanner"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        CornerRadius="9"
                        Background="#1FFF6B6B"
                        BorderBrush="#44FF6B6B"
                        BorderThickness="1"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ErrorText"
                                   FontSize="10.5"
                                   Foreground="#FFFFC9C9"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ErrorActionButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="10"
                                Padding="8,4"
                                Content="Повторить"
                                Click="ErrorAction_Click"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Limit rings -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:RingMeter x:Name="FiveHourMeter"
                                        Grid.Column="0"
                                        Accent="{StaticResource RingFiveBrush}" />
                    <controls:RingMeter x:Name="WeekMeter"
                                        Grid.Column="1"
                                        Accent="{StaticResource RingWeekBrush}" />
                    <controls:RingMeter x:Name="MonthMeter"
                                        Grid.Column="2"
                                        Accent="{StaticResource RingMonthBrush}" />
                </Grid>

                <Border Grid.Row="4"
                        Height="1"
                        Background="{StaticResource DividerBrush}"
                        Margin="0,14,0,0" />

                <!-- Today -->
                <Grid Grid.Row="5" Margin="0,11,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Сегодня"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TopModelText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="9.5"
                                   Foreground="{StaticResource FaintBrush}"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Запросы"
                                       FontSize="9"
                                       Foreground="{StaticResource FaintBrush}" />
                            <TextBlock x:Name="RequestsValue"
                                       Text="-"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Токены"
                                       FontSize="9"
                                       Foreground="{StaticResource FaintBrush}" />
                            <TextBlock x:Name="TokensValue"
                                       Text="-"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Стоимость"
                                       FontSize="9"
                                       Foreground="{StaticResource FaintBrush}" />
                            <TextBlock x:Name="CostValue"
                                       Text="-"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="6" Margin="0,12,0,0">
                    <TextBlock x:Name="FooterText"
                               Text="Автообновление: 60 с"
                               FontSize="9"
                               Foreground="{StaticResource FaintBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="ConsoleLink"
                            HorizontalAlignment="Right"
                            Style="{StaticResource LinkButton}"
                            FontSize="9"
                            Foreground="{StaticResource FaintBrush}"
                            Content="console"
                            Click="ConsoleLink_Click"
                            ToolTip="Открыть OpenCode Console" />
                </Grid>
            </Grid>
        </Border>

        <!-- Compact card -->
        <Border x:Name="CompactCard"
                Margin="16"
                CornerRadius="18"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                TextElement.Foreground="{StaticResource TextBrush}"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.58"
                                  Color="#000000" />
            </Border.Effect>

            <Grid Margin="12,10,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid x:Name="CompactHeader"
                      Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource LogoButton}"
                                Width="20"
                                Height="20"
                                ToolTip="Открыть статистику OpenCode"
                                AutomationProperties.Name="Открыть статистику OpenCode"
                                Click="ConsoleLink_Click">
                            <Image Source="assets/logo.png"
                                   Width="20"
                                   Height="20"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Button>
                        <TextBlock Text="OpenCode"
                                   Margin="6,0,0,0"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border x:Name="CompactPlanBadgeHost"
                                Margin="5,0,0,0"
                                CornerRadius="4"
                                Background="{StaticResource AccentSoftBrush}"
                                Padding="4,1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CompactPlanBadge"
                                       Text="Go"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <Ellipse x:Name="CompactLiveDot"
                                 Width="5"
                                 Height="5"
                                 Fill="{StaticResource WarningBrush}"
                                 Margin="7,0,0,0"
                                 VerticalAlignment="Center" />
                        <Ellipse x:Name="CompactLoadDot"
                                 Width="5"
                                 Height="5"
                                 Fill="{StaticResource WarningBrush}"
                                 Margin="5,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 ToolTip="Состояние OpenCode" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CompactSettingsButton"
                                Style="{StaticResource IconButton}"
                                Width="24"
                                Height="24"
                                Click="Settings_Click"
                                ToolTip="Настройки"
                                AutomationProperties.Name="Настройки">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" />
                        </Button>
                        <Button x:Name="ExpandButton"
                                Style="{StaticResource IconButton}"
                                Width="24"
                                Height="24"
                                Click="CompactToggle_Click"
                                ToolTip="Обычный режим"
                                AutomationProperties.Name="Обычный режим">
                            <TextBlock Text="&#xE70E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" />
                        </Button>
                        <Button x:Name="CompactCloseButton"
                                Style="{StaticResource IconButton}"
                                Width="24"
                                Height="24"
                                Click="Hide_Click"
                                ToolTip="Скрыть в трей"
                                AutomationProperties.Name="Скрыть в трей">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="9" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Mini meters -->
                <Grid Grid.Row="1" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:MiniMeter x:Name="CompactFiveHour"
                                        Grid.Column="0"
                                        Accent="{StaticResource RingFiveBrush}"
                                        Margin="0,0,8,0" />
                    <controls:MiniMeter x:Name="CompactWeek"
                                        Grid.Column="1"
                                        Accent="{StaticResource RingWeekBrush}"
                                        Margin="0,0,8,0" />
                    <controls:MiniMeter x:Name="CompactMonth"
                                        Grid.Column="2"
                                        Accent="{StaticResource RingMonthBrush}" />
                </Grid>

                <!-- Compact error -->
                <Border x:Name="CompactError"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Margin="0,8,0,0"
                        CornerRadius="7"
                        Background="#1FFF6B6B"
                        BorderBrush="#44FF6B6B"
                        BorderThickness="1"
                        Padding="8,5"
                        Cursor="Hand"
                        MouseLeftButtonUp="CompactError_Click">
                    <TextBlock x:Name="CompactErrorText"
                               FontSize="9"
                               Foreground="#FFFFC9C9"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock x:Name="CompactTodayText"
                               Text="Сегодня: -"
                               FontSize="8.5"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CompactUpdatedText"
                               Text=""
                               HorizontalAlignment="Right"
                               FontSize="8.5"
                               Foreground="{StaticResource FaintBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Taskbar overlay -->
        <Border x:Name="TaskbarCard"
                Margin="0"
                CornerRadius="10"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                TextElement.Foreground="{StaticResource TextBrush}"
                Visibility="Collapsed"
                Cursor="Hand"
                MouseLeftButtonDown="TaskbarCard_MouseLeftButtonDown"
                ToolTip="OpenCode Go">
            <Grid Margin="10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource LogoButton}"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        ToolTip="Открыть статистику OpenCode"
                        AutomationProperties.Name="Открыть статистику OpenCode"
                        Click="ConsoleLink_Click">
                    <Image Source="assets/logo.png"
                           Width="18"
                           Height="18"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>

                <Border Grid.Column="1"
                        Margin="6,0,0,0"
                        CornerRadius="4"
                        Background="{StaticResource AccentSoftBrush}"
                        Padding="4,1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TaskbarPlanBadge"
                               Text="Go"
                               FontSize="8"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="5ч"
                                   FontSize="8.5"
                                   Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TaskbarFiveHour"
                                   Text="-"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="нед"
                                   FontSize="8.5"
                                   Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TaskbarWeek"
                                   Text="-"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="мес"
                                   FontSize="8.5"
                                   Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TaskbarMonth"
                                   Text="-"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Margin="10,0,4,0"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="TaskbarLoadDot"
                             Width="5"
                             Height="5"
                             Fill="{StaticResource WarningBrush}"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             ToolTip="Состояние OpenCode" />
                    <Ellipse x:Name="TaskbarLiveDot"
                             Width="5"
                             Height="5"
                             Fill="{StaticResource WarningBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Limit alert pulse, drawn over the visible card -->
        <Border x:Name="AlertGlow"
                Margin="16"
                CornerRadius="18"
                BorderThickness="1.5"
                BorderBrush="{StaticResource DangerBrush}"
                IsHitTestVisible="False"
                Opacity="0" />
    </Grid>
</Window>
