<Window x:Class="OpenCodeWidget.LoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LoadWindowTitle}"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="app.ico"
        KeyDown="Window_KeyDown">

    <Border Margin="16"
            CornerRadius="18"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            TextElement.Foreground="{StaticResource TextBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="0"
                              Opacity="0.58"
                              Color="#000000" />
        </Border.Effect>

        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="assets/logo.png"
                           Width="22"
                           Height="22"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{DynamicResource LoadWindowHeader}"
                               Margin="8,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        ToolTip="{DynamicResource Close}"
                        AutomationProperties.Name="{DynamicResource Close}">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" />
                </Button>
            </Grid>

            <!-- Current state -->
            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    CornerRadius="9"
                    Background="#14FFFFFF"
                    Padding="10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StateIcon"
                                   Text="&#xE9D9;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StateText"
                                   Text="{DynamicResource Load}"
                                   Margin="6,0,0,0"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StateDetail"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- Chart title and scope -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock x:Name="ChartCaption"
                           Text=""
                           FontSize="10.5"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,150,0" />
                <StackPanel x:Name="ScopePanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <RadioButton x:Name="ScopeModel"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Scope"
                                 Content="{DynamicResource ScopeModelPill}"
                                 Height="28"
                                 FontSize="9.5"
                                 Checked="Scope_Changed" />
                    <RadioButton x:Name="ScopeGo"
                                 Style="{StaticResource PillRadio}"
                                 GroupName="Scope"
                                 Content="{DynamicResource ScopeGoPill}"
                                 Height="28"
                                 FontSize="9.5"
                                 Margin="6,0,0,0"
                                 Checked="Scope_Changed" />
                </StackPanel>
            </Grid>

            <!-- Chart -->
            <Border Grid.Row="3"
                    Margin="0,8,0,0"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,1">
                <Grid x:Name="ChartGrid"
                      Height="92" />
            </Border>

            <!-- Hour labels -->
            <Grid Grid.Row="4" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="00" FontSize="8.5" Foreground="{StaticResource FaintBrush}" />
                <TextBlock Grid.Column="1" Text="06" FontSize="8.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="12" FontSize="8.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="18" FontSize="8.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="23" FontSize="8.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Summary -->
            <TextBlock x:Name="SummaryText"
                       Grid.Row="5"
                       Margin="0,14,0,0"
                       FontSize="11"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="NoteText"
                       Grid.Row="6"
                       Margin="0,6,0,0"
                       FontSize="9"
                       Foreground="{StaticResource FaintBrush}"
                       TextWrapping="Wrap" />

            <!-- Footer link -->
            <Button Grid.Row="7"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource LinkButton}"
                    FontSize="9.5"
                    Foreground="{StaticResource FaintBrush}"
                    Content="{DynamicResource OpenStatusPage}"
                    Click="StatusLink_Click" />
        </Grid>
    </Border>
</Window>
