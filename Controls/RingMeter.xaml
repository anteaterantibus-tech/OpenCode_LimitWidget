<UserControl x:Class="OpenCodeWidget.Controls.RingMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenCodeWidget.Controls"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Width="96" Height="96" HorizontalAlignment="Center">
            <local:RingRenderer x:Name="Ring" Thickness="7" />
            <TextBlock x:Name="PercentText"
                       Text="0%"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="TitleText"
                   Grid.Row="1"
                   Text="5 часов"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,7,0,0" />

        <TextBlock x:Name="ResetText"
                   Grid.Row="2"
                   Text=""
                   FontSize="9"
                   Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0"
                   MaxWidth="112"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
